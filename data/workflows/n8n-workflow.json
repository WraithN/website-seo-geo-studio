    {
      "name": "Code: Wireframe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        520
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const f = $('Form Trigger').first().json;\nconst tools = String(f.tools || '').split('\\n').map(s=>s.trim()).filter(Boolean)\n  .map(line => { const p = line.split('|').map(x=>x.trim()); return { n: p[0]||p[1]||'Tool', slug: p[1]||'', desc: p[2]||'' }; });\nconst name = f.name || 'My Site';\nconst wf = `# 线框图：${name}\n## 页面结构\n1. Header / 导航（Logo、工具、定价、博客、语言）\n2. Hero（标题、定位、主 CTA「免费开始」）\n3. 工具网格（${tools.length||'N'} 个工具卡片，hover 预览）\n4. 使用步骤 How-it-works（3 步）\n5. 定价 / 变现（${f.monetization||'ads'}）\n6. FAQ（结构化数据）\n7. Footer（合规链接）\n## 数据流向\n表单提交 → 桥接服务 /generate → 工程目录 → /complete 编码补全 → /publish 发布`;\nreturn [{ json: { wireframe: wf, name, tagline: f.tagline, audience: f.audience } }];"
      }
    },
    {
      "name": "IF: Generate Image",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        320,
        760
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.generateImage }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "name": "HTTP: Wireframe Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        620,
        760
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.IMAGE_API_URL || 'https://api.openai.com/v1/images/generations' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.OPENAI_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"model\": \"gpt-image-1\", \"prompt\": \"Clean wireframe mockup of a SaaS indie tool site: \" + $json.name + \". Minimal box layout, no color.\", \"n\": 1, \"size\": \"1024x1024\" } }}",
        "options": {}
      }
    },
    {
      "name": "Code: Recommend Style",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        520
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const f = $('Form Trigger').first().json;\nconst aud = String(f.audience||'').toLowerCase();\nconst mon = String(f.monetization||'ads');\nlet style='minimal', rationale='通用简洁风格，适配大多数工具站', palette='#5b34e6 / #f8fafc';\nif (/child|kid|儿童|玩|fun|game/.test(aud)) { style='playful'; rationale='目标含儿童/娱乐，用活泼配色与圆角'; palette='#8b6ef0 / #8b6ef0'; }\nelse if (/financ|crypto|投资|money|bank/.test(aud)) { style='midnight'; rationale='金融/严肃场景，深色高端感'; palette='#4a25c9 / #5b34e6'; }\nelse if (/creativ|design|艺术|portfolio/.test(aud)) { style='bold'; rationale='创意向，强对比大胆视觉'; palette='#5b34e6 / #5b34e6'; }\nelse if (/saas|professional|企业|business|团队/.test(aud)) { style='glassmorphism'; rationale='SaaS/企业，玻璃拟态显专业'; palette='#8b6ef0 / #fffdf9'; }\nif ((mon==='subscription'||mon==='freemium') && style==='minimal') style='glassmorphism';\nreturn [{ json: { recommendedStyle: style, rationale, palette, style } }];"
      }
    },
    {
      "name": "IF: Use AI",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        960,
        520
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.useAI }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "name": "HTTP: AI Style",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1260,
        360
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LLM_BASE_URL || 'https://api.openai.com/v1/chat/completions' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.OPENAI_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"model\": $env.LLM_MODEL || 'gpt-4o-mini', \"temperature\": 0.3, \"messages\": [ {\"role\":\"system\",\"content\":\"你是资深 UI 设计顾问。只返回 JSON：{\\\"style\\\":\\\"minimal|bold|playful|glassmorphism|midnight\\\",\\\"rationale\\\":\\\"一句话理由\\\"}\"}, {\"role\":\"user\",\"content\":\"站点：\"+ $json.name +\" 目标用户：\"+ $('Form Trigger').first().json.audience +\" 变现：\"+ $('Form Trigger').first().json.monetization +\" 已有推荐：\"+ $json.recommendedStyle +\"。请确认或修正风格。\"} ] } }}",
        "options": {}
      }
    },
    {
      "name": "Code: Parse AI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        360
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $('HTTP: AI Style').first().json;\nlet style = $('Code: Recommend Style').first().json.recommendedStyle;\nlet rationale = 'AI 辅助建议';\ntry {\n  const content = (r.choices && r.choices[0] && r.choices[0].message && r.choices[0].message.content) || '';\n  const m = content.match(/\\{[\\s\\S]*\\}/);\n  if (m) { const j = JSON.parse(m[0]); if (j.style) style = j.style; if (j.rationale) rationale = j.rationale; }\n} catch (e) {}\nreturn [{ json: { style, recommendedStyle: style, rationale, aiUsed: true } }];"
      }
    },
    {
      "name": "Form: Confirm UI Style",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.2,
      "position": [
        1860,
        520
      ],
      "parameters": {
        "formTitle": "选择 UI 设计风格",
        "formDescription": "AI / 规则推荐：{{ $json.recommendedStyle }} —— {{ $json.rationale }}（配色 {{ $json.palette }}）。可保持或切换。",
        "formFields": {
          "values": [
            {
              "fieldLabel": "最终 UI 风格",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldName": "style",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Minimal 简洁",
                    "value": "minimal"
                  },
                  {
                    "option": "Bold 大胆",
                    "value": "bold"
                  },
                  {
                    "option": "Playful 活泼",
                    "value": "playful"
                  },
                  {
                    "option": "Glassmorphism 玻璃拟态",
                    "value": "glassmorphism"
                  },
                  {
                    "option": "Midnight 深色高端",
                    "value": "midnight"
                  }
                ],
                "mode": "list"
              },
              "defaultValue": "={{ $json.style }}"
            }
          ]
        }
      }
    },
    {
      "name": "Code: Build Spec",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2180,
        520
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const f = $('Form Trigger').first().json;\nconst c = $('Form: Confirm UI Style').first().json;\nconst style = c.style || 'minimal';\nconst slugify = s => s.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'') || 'site';\nconst tools = String(f.tools||'').split('\\n').map(s=>s.trim()).filter(Boolean).map(line=>{\n  const p = line.split('|').map(x=>x.trim());\n  const slug = slugify(p[1]||p[0]||'tool');\n  return { name: p[0]||p[1]||'Tool', slug, desc: p[2]||'', icon:'⚙️', keywords:[] };\n});\nconst themeMap = { minimal:'indigo', bold:'sunset', playful:'emerald', glassmorphism:'ocean', midnight:'midnight' };\nconst slug = f.slug ? slugify(f.slug) : slugify(f.name||'site');\nconst spec = {\n  name: f.name, slug, domain: f.domain || '', tagline: f.tagline||'',\n  lang: f.language || 'en', theme: themeMap[style] || 'ocean',\n  audience: String(f.audience||'').split(',').map(s=>s.trim()).filter(Boolean),\n  keywords: String(f.keywords||'').split(',').map(s=>s.trim()).filter(Boolean),\n  tools,\n  monetization: { model: f.monetization||'ads', currency: f.currency||'USD' },\n  legal: { email: '', jurisdiction: 'global' },\n  deploy: { target: f.deployTarget||'none' }\n};\nconst outDir = 'C:/Users/nathon.wang/WorkBuddy/2026-10-26-00-00-50/n8n-indie-builder/sites/' + slug;\nreturn [{ json: { spec, outDir, build: false, style } }];"
      }
    },
