# ===== SEO/GEO Studio 环境变量 =====
# 复制为 .env 并按需填写。所有项均可留空（使用免费源 + 优雅降级）。

# 后端端口
PORT=8789

# 视觉模型（Similarweb / Semrush 截图自动提取指标时使用）
# 未配置时截图仅存档，可改用手填指标。
# 推荐免费多模态模型：智谱 glm-4v-flash / 阿里 qwen-vl-plus
VISION_LLM_API_KEY=
VISION_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_LLM_MODEL=glm-4v-flash

# 对话模型（若本身为多模态 4o/glm-4v/qwen-vl/gemini，可复用其 key 做截图提取）
CHAT_LLM_API_KEY=
CHAT_LLM_BASE_URL=https://api.openai.com/v1
CHAT_LLM_MODEL=gpt-4o-mini

# 联网抓取超时（毫秒）
RESEARCH_TIMEOUT_MS=12000

# 设为 1 时使用内置样例数据（无网环境验证整条流水线，无需联网）
RESEARCH_OFFLINE=0
